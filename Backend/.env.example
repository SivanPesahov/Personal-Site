# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-me

# Origins של הפרונט (אפשר כמה, מופרדים בפסיק)
CORS_ORIGINS=http://localhost:3000

# Postgres URL (Supabase / Neon)
# פורמט: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# דוגמה:
# DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/personal_site

# Rate limit ברירת מחדל (נשתמש בהמשך)
RATELIMIT_DEFAULT=100/hour